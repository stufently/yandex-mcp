# Yandex Search API (https://console.yandex.cloud/)
YANDEX_SEARCH_API_KEY=
YANDEX_FOLDER_ID=

# Yandex Wordstat (https://console.yandex.cloud/) — NOT OAuth: since v2.0 Wordstat talks to
# Cloud Search API v2 with an API key of a service account (role search-api.webSearch.user)
WORDSTAT_API_KEY=
WORDSTAT_FOLDER_ID=

# Yandex Webmaster (https://oauth.yandex.com/)
YANDEX_WEBMASTER_TOKEN=

# Yandex Metrika (https://oauth.yandex.com/)
# Reading needs metrika:read; create-counter/delete-counter also need metrika:write,
# which is why the auth helper requests both by default.
YANDEX_METRIKA_TOKEN=
# Optional: narrow the scopes the auth helper asks for, e.g. "metrika:read" for a
# token that cannot modify counters. Default: metrika:read metrika:write
YANDEX_METRIKA_SCOPE=

# Yandex Direct API v5 (https://oauth.yandex.com/)
YANDEX_DIRECT_TOKEN=
# Only for agency accounts acting on behalf of a client:
YANDEX_DIRECT_CLIENT_LOGIN=
# Set to "true" to use the Direct sandbox instead of production:
YANDEX_DIRECT_SANDBOX=

# Optional: for OAuth flow (node packages/<package>/src/index.mjs auth)
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=
