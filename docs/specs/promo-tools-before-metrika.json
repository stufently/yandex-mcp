[
  {
    "name": "get-counters",
    "inputSchema": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "type": "object",
      "properties": {}
    }
  },
  {
    "name": "get-counter",
    "inputSchema": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "type": "object",
      "properties": {
        "counter_id": {
          "type": "number",
          "description": "Counter ID"
        }
      },
      "required": ["counter_id"]
    }
  },
  {
    "name": "get-goals",
    "inputSchema": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "type": "object",
      "properties": {
        "counter_id": {
          "type": "number",
          "description": "Counter ID"
        }
      },
      "required": ["counter_id"]
    }
  },
  {
    "name": "create-counter",
    "inputSchema": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "Counter name"
        },
        "site": {
          "type": "string",
          "description": "Site domain (e.g. \"example.com\")"
        },
        "mirrors": {
          "description": "Mirror domains",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "time_zone_name": {
          "description": "Timezone (e.g. \"Europe/Moscow\")",
          "type": "string"
        },
        "gdpr_agreement_accepted": {
          "description": "GDPR agreement accepted (required for EU)",
          "type": "boolean"
        }
      },
      "required": ["name", "site"]
    }
  },
  {
    "name": "delete-counter",
    "inputSchema": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "type": "object",
      "properties": {
        "counter_id": {
          "type": "number",
          "description": "Counter ID to delete"
        },
        "confirm": {
          "description": "Must be exactly true to actually delete. Omit it (or pass false) and the tool refuses without calling the Metrika API.",
          "type": "boolean"
        }
      },
      "required": ["counter_id"]
    }
  },
  {
    "name": "get-traffic-summary",
    "inputSchema": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "type": "object",
      "properties": {
        "counter_id": {
          "type": "number",
          "description": "Counter ID"
        },
        "date_from": {
          "description": "Start date YYYY-MM-DD",
          "type": "string"
        },
        "date_to": {
          "description": "End date YYYY-MM-DD",
          "type": "string"
        }
      },
      "required": ["counter_id"]
    }
  },
  {
    "name": "get-traffic-sources",
    "inputSchema": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "type": "object",
      "properties": {
        "counter_id": {
          "type": "number",
          "description": "Counter ID"
        },
        "date_from": {
          "type": "string"
        },
        "date_to": {
          "type": "string"
        },
        "limit": {
          "description": "Max results (default: 10)",
          "type": "number",
          "minimum": 1
        }
      },
      "required": ["counter_id"]
    }
  },
  {
    "name": "get-geography",
    "inputSchema": {
      "$schema": "http://json-schema.org/draft-07/schema#",
